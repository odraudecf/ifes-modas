# Endereço da API. Copie para .env.local e ajuste.
#   dotnet run (perfil http)  -> http://localhost:5112
#   docker compose up         -> http://localhost:8080
# No Render, o Blueprint preenche só o host (ex.: ifes-modas-api.onrender.com); o front completa com https://.
VITE_API_URL=http://localhost:5112
